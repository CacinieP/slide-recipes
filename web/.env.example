# Current version uses the user's model API key from the browser form.
# Reserved for the future authenticated website model endpoint.
# Currently unused by the public BYOK proxy; never expose this in the browser.
MODELBEST_API_KEY=

# Production proxy requests require shared rate limiting. Missing/unavailable
# Redis fails closed with HTTP 503. Local development uses bounded local limits.
# Configure these as server-only secrets; never prefix them with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner-approved exact HTTPS base URLs, comma-separated; server-only.
MODEL_PROXY_ALLOWED_BASE_URLS=
# Vercel defaults to proxy /api/proxy; Pages defaults to direct.
NEXT_PUBLIC_MODEL_REQUEST_MODE=proxy
NEXT_PUBLIC_MODEL_PROXY_URL=
